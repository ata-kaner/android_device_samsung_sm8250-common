type hal_samsung_snap_default, domain;
hal_server_domain(hal_samsung_snap_default, hal_samsung_snap)

type hal_samsung_snap_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_samsung_snap_default)

binder_call(hal_samsung_snap_default, servicemanager)

# DSP, GPU, NPU, ION and DMA-BUF access for neural inference
allow hal_samsung_snap_default gpu_device:chr_file rw_file_perms;
allow hal_samsung_snap_default ion_device:chr_file r_file_perms;
allow hal_samsung_snap_default dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_samsung_snap_default vendor_qdsp_device:chr_file r_file_perms;
allow hal_samsung_snap_default vendor_xdsp_device:chr_file r_file_perms;
allow hal_samsung_snap_default vendor_npu_device:chr_file r_file_perms;
r_dir_file(hal_samsung_snap_default, adsprpcd_file)

# FastRPC / DSP properties
get_prop(hal_samsung_snap_default, vendor_adsprpc_prop)

# Allow using shared buffer FDs passed from system_app (sec_camerax_service)
allow hal_samsung_snap_default system_app:fd use;
